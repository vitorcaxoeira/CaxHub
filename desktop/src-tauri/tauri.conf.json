{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaxHub Desktop",
  "version": "0.1.0",
  "identifier": "br.com.caxhub.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/cabecalho.bmp",
        "sidebarImage": "installer/lateral.bmp",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
