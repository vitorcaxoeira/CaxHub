SOAP_URL="https://exemplo-api-soap.com/servico"
SOAP_USER="usuario_servico"
SOAP_PASSWORD="senha_servico"

# Senior HCM (modulo Pessoas/RH). O HCM e um segundo sistema Senior:
#   - SENIOR_HCM_SOAP_URL/USER/PASSWORD preenchidos: servico proprio do HCM (os tres valem juntos).
#   - vazios: o HCM usa o servico do ERP acima, e SENIOR_HCM_BANCO diz em que database ele esta.
#   SENIOR_HCM_BANCO  prefixo das tabelas do RH, ex.: rhsenior.dbo.
# Sem SENIOR_HCM_BANCO nem SENIOR_HCM_SOAP_URL a sincronizacao do HCM nao e agendada.
SENIOR_HCM_SOAP_URL=
SENIOR_HCM_SOAP_USER=
SENIOR_HCM_SOAP_PASSWORD=
SENIOR_HCM_BANCO="rhsenior.dbo."

