// Espelho local da tabela E045PLA do Senior ERP (Tabelas - Plano Contábil - Contas).
model PlanoContabil {
  codemp           Int
  ctared           Int
  descta           String    @db.VarChar(250)
  clacta           String    @db.VarChar(30)
  /// Domínio "LGruCta": A=Ativo (Contábil - Devedora), P=Passivo (Contábil - Credora), D=Despesas (Contábil - Devedora), R=Receitas (Contábil - Credora), X=Ambas (Contábil - Desp./Rec.), M=Receitas Financeiras, N=Despesas Financeiras, U=Conta Auxiliar, L=Patrimônio Líquido, V=Custo de Venda, C=Custo de Produção, S=Custo de Ordem Dedutora, E=Custo de Ordem Credora, O=Outros, T=Contas de Compensação
  defgru           String    @db.VarChar(1)
  /// Domínio "LNatCtb": D=Devedora, C=Credora
  natcta           String    @db.VarChar(1)
  /// Domínio "LAnaSin": A=Analítico(a), S=Sintético(a)
  anasin           String    @db.VarChar(1)
  // "Conta Paralela" — agrupamento gerencial que hoje coincide com departamento (ADM, CERP,
  // CHCM, COM, DEV, SERP, SHCM; vazio = sem grupo, geralmente conta patrimonial). Confirmado
  // no dicionário (E045PLA.DesPar, VARCHAR(80) nullable) e validado batendo exato contra o
  // relatório de origem, célula a célula, em 12/08/2026 — ver contabilDominio.ts pro mapa
  // grupo -> depexe (ainda não usado em RBAC, é o gancho pra "gestor só vê seu depto").
  despar           String?   @db.VarChar(80)
  // NÍVEL DA CONTA NA HIERARQUIA (E045PLA.NivCta) — 1..15. O Senior já entrega isto pronto:
  // não é preciso deduzir do comprimento de `clacta`. Conferido contra a derivação por
  // máscara em 12/08/2026: 547 de 547 contas idênticas, zero divergência.
  nivcta           Int?
  // Máscara do grupo a que a conta pertence (E045PLA.MskGcc) — ex. "1.22.33.44.5555.66666",
  // que significa larguras acumuladas 1,3,5,7,11,16. É o que torna a hierarquia portátil
  // entre planos de contas diferentes (CaxHub_Hedel): as larguras passam a vir do dado, em
  // vez de constante no código. Varia por modelo E por grupo de contas — o modelo 188 do
  // Senior, por exemplo, usa "1.22.33.44.55" no Ativo/Passivo e "1.22.33.44.55.66" no
  // grupo X. Ver domain/hierarquiaPlano.ts.
  mskgcc           String?   @db.VarChar(40)
  // Grupo de contas do modelo de plano (E045PLA.GruCta) — o `codgcc` que casa com
  // E043MMP.CodGcc, onde vive a máscara por grupo.
  gructa           Int?
  /// Domínio "LSitCta": A=Ativa, I=Inativa
  // Deliberadamente NÃO filtrado nas visões contábeis: as 4 contas inativas de hoje têm
  // movimento até set/2025, e excluí-las mudaria números de anos fechados sem ninguém pedir.
  sitcta           String?   @db.VarChar(1)
  // Conta-pai na hierarquia — DERIVADO no fim do sync (o Senior não tem "CtaPai" em
  // E045PLA, só em E044CCU.CcuPai). É a conta de `nivcta - 1` cujo `clacta` é prefixo deste,
  // com o comprimento do prefixo vindo de `mskgcc`. Sem FK formal, mesma escolha de
  // CentroCusto.ccupai. NULL = raiz (nivcta 1).
  paiCtared        Int?      @map("pai_ctared")
  // Carimbo da execução de sync que viu esta linha na origem pela última vez. NULL =
  // nunca vista por uma sync. A varredura compara com `lt` estrito, e `NULL < x` é NULL
  // em SQL — linha nunca carimbada é imune por construção, o que protege registro que
  // nasça no CaxHub em vez de vir do Senior.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  // Quando a varredura constatou que a linha sumiu da origem. NULL = viva. Volta a NULL
  // sozinho se a linha reaparecer, porque todo upsert grava NULL aqui. Nunca há DELETE.
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  @@id([codemp, ctared])
  @@map("plano_contabil")
}

// Espelho local da tabela E046HPD do Senior ERP (Tabelas - Históricos Padrões) — catálogo de
// templates de texto usado pra montar o "Complemento Hist." de um lançamento contábil (ver
// LancamentoContabil.codhpd/cpllct e domain/historicoPadrao.ts). Até 10/09/2026 ficava SEM
// `removidoEmSenior` de propósito (decisão confirmada com o Vitor em 01/09/2026: catálogo de
// configuração, raramente muda, não é dado transacional). Revertido em 10/09/2026: a convenção
// nova (sempre o controle completo em toda tabela espelho, sem exceção por "tabela pequena")
// passou a valer também pra esta — ver `sempre-criar-controle-de-removidos-tabela-senior` no
// segundo cérebro.
model HistoricoPadrao {
  // SEM codemp — confirmado ao vivo contra o dicionário de dados do Senior (r996tbl.pkflds =
  // "CodHpd" sozinho): E046HPD é catálogo GLOBAL, não por empresa, diferente da maioria das
  // tabelas espelhadas aqui. `SELECT CodEmp FROM E046HPD` dá erro de coluna inexistente no
  // Senior — não repetir esse campo por hábito de copiar o padrão de outras tabelas.
  codhpd           Int       @id
  tithpd           String?   @db.VarChar(80)
  // TEMPLATE do histórico — placeholders são `*NUM` (numérico) e `*ALF` (alfanumérico),
  // substituídos POSICIONALMENTE pelos parâmetros de LancamentoContabil.cpllct, na ordem em
  // que aparecem no texto (a distinção NUM/ALF é só validação de entrada no Senior, não muda
  // a substituição). Ex.: "Vlr. Ref. Compra conf. NF *NUM de *ALF".
  deshpd           String    @db.VarChar(80)
  /// Domínio "LTipHpd"
  tiphpd           String    @db.VarChar(1)
  /// Domínio "LSimNao"
  intagr           String?   @db.VarChar(1)
  // Colunas de controle de exclusão — ver comentário em Pedido. Catálogo GLOBAL (sem
  // codemp) — escopo da varredura é `{}` (tabela toda), igual a qualquer outra sem partição.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  @@map("historicos_padrao")
}

// Espelho local da tabela E640LCT do Senior ERP (Contábil - Lançamento - Lançamentos Contábeis).
model LancamentoContabil {
  codemp           Int
  numlct           BigInt
  /// Domínio "LSitLot": 1=A Contabilizar, 2=Contabilizado, 3=Excluído, 4=Desativado
  sitlct           Int
  /// Domínio "LOriLct": MAN=Manual, VEN=Mercado - NF de Saída, VEF=Mercado - Faturas, EST=Estoques - Movimentos, REC=C. Receber - Movimentos, AFR=C. Receber - Ajuste Financeiro, RAM=C. Receber - Ajuste Valor de Mercado, ARV=C. Receber - Variação Cambial, CPR=Suprimentos - NF de Entrada, COF=Suprimentos - Faturas, PAG=C. Pagar - Movimentos, COM=C. Pagar - Comissões, AFP=C. Pagar - Ajuste Financeiro, PAM=C. Pagar - Ajuste Valor de Mercado, APV=C. Pagar - Variação Cambial, TES=Tesouraria - Movimentos, PRD=Produção, PAT=Patrimônio, IVE=Tributos - Vendas, ICO=Tributos - Compras, IVZ=Tributos - Redução Z, IOD=Tributos - Outros Documentos, IMP=Tributos - Apuração/Cálculo, RPA=Tributos - Recibo de Pagamento Autônomo, UIV=Tributos - Unidade Imobiliária Vendida, IVR=Tributos - Unidade Imobiliária Vendida - Valores Recebidos, IVO=Tributos - Unidade Imobiliária Vendida - Custo Orçado, IVI=Tributos - Unidade Imobiliária Vendida - Custo Incorrido, PRJ=Projetos - Lançamentos Manuais, CTC=Cota Capital - Movimentos, VRB=Vetorh - Rubi, REG=Regente
  orilct           String    @db.VarChar(3)
  cpllct           String?   @db.VarChar(250)
  numlot           Int?
  // Código do histórico padrão (E640LCT.CodHpd) — chave de junção com HistoricoPadrao. É o
  // que de fato monta o texto legível do "Complemento Hist." mostrado no Senior: `cpllct` é
  // só a lista de parâmetros ("607543","Senior Sistemas S.A."), o texto final vem de
  // substituir os placeholders (*NUM/*ALF) do template (HistoricoPadrao.deshpd) por esses
  // parâmetros, na ordem em que aparecem — ver domain/historicoPadrao.ts. NÃO é 1:1 com
  // `orilct`: o mesmo orilct (ex. CPR) usa códigos de histórico diferentes conforme a rotina
  // exata que gerou o lançamento, cada um com seu próprio número de parâmetros.
  codhpd           Int?
  // Carimbo da execução de sync que viu esta linha na origem pela última vez. NULL =
  // nunca vista por uma sync. A varredura compara com `lt` estrito, e `NULL < x` é NULL
  // em SQL — linha nunca carimbada é imune por construção, o que protege registro que
  // nasça no CaxHub em vez de vir do Senior.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  // Quando a varredura constatou que a linha sumiu da origem. NULL = viva. Volta a NULL
  // sozinho se a linha reaparecer, porque todo upsert grava NULL aqui. Nunca há DELETE.
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  @@id([codemp, numlct])
  @@map("lancamentos_contabeis")
}

// Espelho local da tabela E640RAT do Senior ERP (Contábil - Lançamento - Rateios).
model RateioLancamento {
  codemp           Int
  numlct           BigInt
  ctared           Int
  codccu           String    @db.VarChar(9)
  /// Domínio "LDebCre": D=Débito, C=Crédito
  debcre           String?   @db.VarChar(1)
  datlct           DateTime  @db.Date
  vlrrat           Decimal   @db.Decimal(17, 2)
  /// Domínio "LSitLot": 1=A Contabilizar, 2=Contabilizado, 3=Excluído, 4=Desativado
  sitrat           Int
  // Carimbo da execução de sync que viu esta linha na origem pela última vez. NULL =
  // nunca vista por uma sync. A varredura compara com `lt` estrito, e `NULL < x` é NULL
  // em SQL — linha nunca carimbada é imune por construção, o que protege registro que
  // nasça no CaxHub em vez de vir do Senior.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  // Quando a varredura constatou que a linha sumiu da origem. NULL = viva. Volta a NULL
  // sozinho se a linha reaparecer, porque todo upsert grava NULL aqui. Nunca há DELETE.
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  @@id([codemp, numlct, ctared, codccu])
  // A PK começa por numlct, inútil pra agregação por período — sem este índice, o
  // Resultado Analítico (agrupa por codemp+sitrat+mês, casando por ctared) faz seq scan
  // nas 300k+ linhas da tabela a cada consulta.
  @@index([codemp, sitrat, datlct, ctared])
  @@map("rateios_lancamento")
}

// Espelho local da tabela E650RTO do Senior ERP (Contábil - Saldo - Mensal e Orçamento por Centro de Custos (PC)).
model OrcamentoContabil {
  codemp           Int
  codfil           Int
  mesano           DateTime  @db.Date
  ctared           Int
  codccu           String    @db.VarChar(9)
  ctafin           Int
  vlrrat           Decimal   @db.Decimal(17, 2)
  // Carimbo da execução de sync que viu esta linha na origem pela última vez. NULL =
  // nunca vista por uma sync. A varredura compara com `lt` estrito, e `NULL < x` é NULL
  // em SQL — linha nunca carimbada é imune por construção, o que protege registro que
  // nasça no CaxHub em vez de vir do Senior.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  // Quando a varredura constatou que a linha sumiu da origem. NULL = viva. Volta a NULL
  // sozinho se a linha reaparecer, porque todo upsert grava NULL aqui. Nunca há DELETE.
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  @@id([codemp, codfil, mesano, ctared, codccu, ctafin])
  @@map("orcamentos_contabeis")
}

// Espelho local da tabela USU_TE777RDV do Senior ERP (Registro Despesas de Viagem) — despesa
// de viagem lançada numa RAT (mesma chave natural de Rat: codemp+numrat). Investigado a pedido
// do Vitor em 13/08/2026, junto das 3 tabelas de rota abaixo; sem FK formal pra Rat (mesmo
// espírito de AtividadeConsultor.codfor — casamento por valor, sync de Rat/RDV pode chegar em
// qualquer ordem).
//
// TABELA DE MÃO DUPLA (desde 13/08/2026, quando entrou o lançamento de despesa pelo CaxHub):
// PK local `id` autoincrement, chave natural do Senior só no @@unique — mesmo padrão de
// Rat/RatItem, e pela mesma razão. `seqrdv` é numeração DO SENIOR: despesa criada aqui nasce
// com ele nulo, porque gerar um MAX+1 local colidiria com uma despesa lançada no ERP no
// intervalo, e o upsert do próximo sync sobrescreveria em silêncio o lançamento do consultor.
model RegistroDespesaViagem {
  id     Int       @id @default(autoincrement())
  codemp Int
  numrat Int
  // Nulo até o Senior confirmar (só linha que veio de lá tem número).
  seqrdv Int?
  datemi DateTime? @db.Date
  desrdv String?   @db.VarChar(250)
  /// Domínio "USU_LTIPDES" — sem tradução no dicionário desta instalação do Senior (R940END
  /// vazio). 7 valores vistos (1..7); não dá pra rotular com confiança pela descrição livre.
  tipdes Int?
  /// Domínio "USU_LRdvTipDes" (mesmo domínio de PercursoViagem.modtra) — idem, sem tradução.
  moddes String?   @db.VarChar(1)
  qtdrdv Int?
  vlrunt Decimal?  @db.Decimal(9, 2)
  vlrtot Decimal?  @db.Decimal(9, 2)
  /// Domínio "LSimNao": S=Sim, N=Não — fatura o cliente por esta despesa.
  fatrdv String?   @db.VarChar(1)
  /// Domínio "LSimNao": S=Sim, N=Não — reembolsa o consultor por esta despesa.
  reerdv String?   @db.VarChar(1)
  // Rota pré-cadastrada vinculada (RotaViagem.id) — na prática quase sempre vazia (90 de
  // 15.034 linhas em 13/08/2026); a maioria das despesas não usa o catálogo de rotas.
  rotid  Int?
  hordes Int?
  nidpso Int? // Id espelhado de uma integração externa (PSOffice) — não usado no CaxHub.

  // true = lançada pelo consultor no CaxHub (ver POST /rats/:id/despesas); false = veio do
  // Senior pelo sync. É por aqui que a varredura de envio pendente acha o que falta mandar
  // (só quem nasceu aqui tem o que enviar). Editar/excluir (07/09/2026) não depende mais
  // disso — qualquer despesa da RAT pode ser alterada enquanto Rat.sitrat = Digitado, ver
  // podeAlterarDespesasDaRat em routes/rats.ts.
  origemCaxHub    Boolean   @default(false)
  // Quando a despesa criada aqui foi de fato gravada no Senior — preenchido pelo write-back
  // atômico de sync/outboxSeniorDespesa.ts (operação `ManterItemDespesa`, publicada em
  // 07/09/2026). NULL + origemCaxHub = ainda não foi enviada (é o que faz `pendenteDeEnvio`
  // em GET /rats/:id/despesas).
  enviadoEmSenior DateTime? @map("enviado_em_senior")
  // Preenchido quando a exclusão foi efetivada: na hora, se a despesa nunca tinha ido pro
  // Senior (seqrdv nulo — não há o que desfazer lá); só depois da confirmação de
  // `ManterItemDespesa` com tipEve=E quando já tinha seqrdv. Soft delete de propósito (08/09/
  // 2026, pedido do Vitor) — mesmo princípio de nunca apagar Rat/RatItem que já existiram no
  // ERP, só desvincular/marcar: a despesa some das telas (ver filtro em GET /:id/despesas),
  // mas o registro fica pra rastreabilidade de valor faturado/reembolsado.
  excluidaEm      DateTime? @map("excluida_em")

  // Colunas de controle de exclusão — ver comentário em Pedido e em Rat. MÃO DUPLA: mesmo
  // escopo `{ origemCaxHub: false }` de Rat/RatItem — nunca marcar como "removida do Senior"
  // uma despesa lançada aqui e ainda não enviada (`enviadoEmSenior` nulo). Sem relação com
  // `excluidaEm` acima: aquele é soft-delete por ação do usuário (exclusão INTENCIONAL),
  // este é detecção de sumiço na ORIGEM — os dois podem, em tese, coexistir na mesma linha.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  sincronizacoesPendentes SincronizacaoPendenteDespesa[]

  @@unique([codemp, numrat, seqrdv])
  @@map("registros_despesa_viagem")
}

// Fila de envio de despesa (RDV) pro Senior via `ManterItemDespesa` — mesmas regras de
// sync/outboxSenior.ts (pendente/enviando/enviado/bloqueado, retentativa, write-back atômico),
// mas em tabela própria: RegistroDespesaViagem não tem relação com AtividadeConsultor, que é a
// FK obrigatória de SincronizacaoPendente. Ver sync/outboxSeniorDespesa.ts.
model SincronizacaoPendenteDespesa {
  id           Int                   @id @default(autoincrement())
  despesaId    Int
  despesa      RegistroDespesaViagem @relation(fields: [despesaId], references: [id])
  // enviar_despesa (tipEve=I, default/legado) | editar_despesa (tipEve=A, exige seqrdv) |
  // excluir_despesa (tipEve=E, exige seqrdv) — ver sync/outboxSeniorDespesa.ts.
  tipo         String                @default("enviar_despesa") @db.VarChar(40)
  payload      Json
  // pendente | enviando | enviado | bloqueado — mesmo significado de SincronizacaoPendente.status.
  status       String                @default("pendente") @db.VarChar(20)
  tentativas   Int                   @default(0)
  ultimoErro   String?
  criadoEm     DateTime              @default(now())
  processadoEm DateTime?

  @@map("sincronizacao_pendente_despesa")
}

// Espelho local da tabela USU_TRDVROTAS do Senior ERP (Tabela de Rotas) — rota de viagem
// pré-cadastrada por cliente, composta por percursos (ver RotaPercurso).
model RotaViagem {
  id               Int       @id
  codcli           Int?
  desrot           String?   @db.VarChar(250)
  kmtrot           Decimal?  @db.Decimal(10, 2)
  horrot           Int?
  /// Domínio "LSitReg": A=Ativo, I=Inativo
  sitreg           String?   @db.VarChar(1)
  idagp            Int?
  tolhrs           Decimal?  @db.Decimal(7, 2)
  tolkm            Decimal?  @db.Decimal(7, 2)
  // Colunas de controle de exclusão — ver comentário em Pedido.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  @@map("rotas_viagem")
}

// Espelho local da tabela USU_TRDVPER do Senior ERP (Tabela de Percursos) — trecho reutilizável
// (origem/destino) que compõe uma ou mais rotas via RotaPercurso.
model PercursoViagem {
  id               Int       @id
  perori           String?   @db.VarChar(100)
  perdes           String?   @db.VarChar(100)
  desper           String?   @db.VarChar(250)
  kmtper           Decimal?  @db.Decimal(10, 2)
  horper           Int?
  /// Domínio "USU_LRdvTipDes" (mesmo domínio de RegistroDespesaViagem.moddes) — modalidade do
  /// transporte; sem tradução no dicionário desta instalação.
  modtra           String?   @db.VarChar(1)
  horpag           Int?
  // Colunas de controle de exclusão — ver comentário em Pedido.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  @@map("percursos_viagem")
}

// Espelho local da tabela USU_TRDVROTPER do Senior ERP (Rotas x Percursos) — junção rota↔percurso
// com a ordem de cada trecho dentro da rota. `id` é a PK própria desta linha de junção, NÃO o id
// da rota (o dicionário do Senior nomeia os dois campos "Id. da Rota", mas são coisas diferentes —
// confirmado com dado real: `id` sobe 1,2,3,8,9... enquanto `rotid` repete 1,1,1,5,5,5...).
model RotaPercurso {
  id               Int       @id
  rotid            Int
  perid            Int
  ordseq           Int
  // Colunas de controle de exclusão — ver comentário em Pedido.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  @@map("rotas_percursos")
}

// Filtro de sincronização aplicado na importação do ERP Senior — Fase 3 do plano de filtros
// (~/.claude/plans/se-liga-na-necessidade-resilient-lark.md), refinado na Fase 6 (21/08/2026):
// até 2 filtros INDEPENDENTES por tabela, um por `modo` ("todos" — vale pro cron também, já
// que o cron sempre roda sem `desde` — e "alterados" — só quando a sincronização incremental
// roda). Mesmo vocabulário "todos"/"alterados" já usado em `POST /:jobName/run`
// (routes/syncErp.ts), não um enum novo. `predicados` guarda a estrutura EDITÁVEL (campo de
// origem + operador + valores, ver sync/filtroSenior.ts:PredicadoFiltro); o fragmento SQL de
// verdade nunca é gravado aqui, só montado em runtime — assim uma mudança na regra de
// validação vale pra filtro salvo antes dela existir, sem precisar migrar dado. Propagar
// "todos" pra "alterados" é uma CÓPIA única (rota própria, sync/filtrosAtivos.ts) — depois de
// propagado, os dois evoluem independentes, não ficam vinculados.
model FiltroSincronizacao {
  jobName       String   @map("job_name")
  modo          String
  predicados    Json
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  atualizadoPor Int?     @map("atualizado_por")

  @@id([jobName, modo])
  @@map("filtros_sincronizacao")
}

// Modo de varredura de removidos configurado pelo admin, por job — substitui o Record fixo
// que vivia em sync/politicaVarredura.ts (mudar exigia deploy). "desligada" | "simular" |
// "marcar" — rollout obrigatório em 3 estágios, nunca pula direto pra "marcar" (ver
// sync/varrerRemovidos.ts). Resolvido em memória no boot por sync/politicaVarredura.ts (mesmo
// padrão de FiltroSincronizacao/filtrosAtivos.ts), nunca lido cru pelos jobs de sync.
// `SYNC_VARREDURA=off` no .env continua checado ANTES disso — válvula de emergência sem
// deploy, intocada por este recurso. `modo` aqui é um conceito DIFERENTE do `modo` de
// FiltroSincronizacao acima (aquele é "todos"/"alterados", filtro de importação) — mesma
// palavra, tabelas e propósitos diferentes, cuidado ao ler/escrever os dois.
model ConfiguracaoVarredura {
  jobName       String   @id @map("job_name")
  modo          String   @default("desligada")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  atualizadoPor Int?     @map("atualizado_por")

  @@map("configuracoes_varredura")
}

// Tamanho do lote de upsert (sync/upsertEmLote.ts), configurado pelo admin, por job — mesmo
// padrão de ConfiguracaoVarredura acima (11/09/2026, porte do CaxHub_Atlas a pedido do
// Vitor). `tamanhoLote` nullable: sem linha salva já significa "usa o default de
// upsertEmLote.ts" (TAMANHO_LOTE_PADRAO = 1000) — não duplica esse número aqui. Resolvido em
// memória no boot por sync/politicaLote.ts, nunca lido cru pelos jobs de sync. Só faz sentido
// pra jobs com `usaUpsertEmLote: true` em registry.ts — os demais ainda gravam linha a linha,
// sem opção de lote nenhuma (não é config, é código que ainda não foi escrito).
model ConfiguracaoLote {
  jobName       String   @id @map("job_name")
  tamanhoLote   Int?     @map("tamanho_lote")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  atualizadoPor Int?     @map("atualizado_por")

  @@map("configuracoes_lote")
}

// Domínio fechado declarado pelo próprio contrato do Kyria (`enum: [active, inactive]` no
// OpenAPI, em todo catálogo) — vale a pena travar em tipo de banco, ao contrário de `key`/
// `name`/`description`/`id`, que são texto livre de verdade (o Kyria não garante formato nem
// tamanho pra essas strings, só que `id`/`parentTeamId` são opacas). Reaproveitado pelos
// próximos catálogos Kyria (customers, projects, labels, ...) — todos compartilham esse mesmo
// domínio de status.
enum KyriaStatus {
  active
  inactive
}

// Espelho local do Kyria (API REST, ver src/kyria/client.ts) — segunda origem de dados do
// CaxHub ao lado do Senior, pra compor a visão de rentabilidade. `id` é a string opaca do
// Convex (não numérica, diferente das PKs inteiras dos espelhos do Senior). Sem
// `removidoEmSenior`/varredura: o Kyria já expõe o estado do registro via `status`
// (active/inactive) — não "desaparece" da API como uma linha excluída no Senior, então o
// mecanismo de detecção de exclusão (sync/varrerRemovidos.ts) não se aplica aqui.
model KyriaTeam {
  id             String      @id
  key            String
  name           String
  description    String?
  appearance     Json?
  parentTeamId   String?     @map("parent_team_id")
  status         KyriaStatus
  sincronizadoEm DateTime    @updatedAt @map("sincronizado_em")

  // Lado inverso de KyriaTicket.team — FK real (22/09/2026, pedido do Vitor: cruzar
  // kyria_tickets.team_id com kyria_teams.id).
  tickets KyriaTicket[]

  @@map("kyria_teams")
}

// Domínio de `role` em GET /members, declarado no OpenAPI do Kyria — mesmo espírito de
// KyriaStatus (domínio fechado, vale travar em tipo de banco). Só usado por KyriaMember hoje.
enum KyriaMemberRole {
  attendant
  manager
  requester
  participant
  admin
  service_manager
  customer_request_manager
}

// Espelho local do Kyria — GET /members (ver src/kyria/client.ts, src/kyria/membersSync.ts).
// Campos e tipos vieram do mapeamento registrado pela tela Administração > Integração Kyria >
// Mapeamento de Campos (recurso `/members`, registrado pelo Vitor em 18/09/2026) — ver
// KyriaResourceMapping/KyriaFieldMapping. Uma correção em cima do que foi registrado: `codusu`
// estava marcado como BigInt no registro, mas o campo que ele documenta apontar
// (Consultor.codusu) é `Int` — usado `Int` aqui pra bater com o alvo real do relacionamento.
model KyriaMember {
  id             String          @id
  name           String
  email          String
  status         KyriaStatus
  role           KyriaMemberRole
  // Campo interno (não vem da API) — documentado no mapeamento como referência a
  // Consultor.codusu, mas SEM FK Prisma de verdade: Consultor tem chave composta
  // (codemp+codusu), e o mapeamento registrado só rastreia codusu isolado, sem codemp. Nunca
  // populado pelo sync automático (não existe regra de casamento definida — ex.: por e-mail)
  // — fica null até alguém decidir como resolver o vínculo e escrever esse código.
  codusu         Int?
  sincronizadoEm DateTime        @updatedAt @map("sincronizado_em")

  // Lado inverso de KyriaTicket.responsavel — FK real (22/09/2026, pedido do Vitor: cruzar
  // kyria_tickets.responsible_user_id com kyria_members.id).
  ticketsComoResponsavel KyriaTicket[]

  @@map("kyria_members")
}

// Espelho local do Kyria — GET /customers (ver src/kyria/client.ts, src/kyria/customersSync.ts).
// Campos e tipos vieram do mapeamento registrado pela tela Administração > Integração Kyria >
// Mapeamento de Campos (recurso `/customers`, registrado pelo Vitor em 18/09/2026) — ver
// KyriaResourceMapping/KyriaFieldMapping. Primeiro model Kyria a aplicar de verdade o `tamanho`
// registrado (@db.VarChar) — em KyriaTeam/KyriaMember isso tinha ficado só metadado, sem virar
// coluna de verdade; aqui vale a pena porque os valores fazem sentido (id/slug/name curtos,
// domainUrl mais largo pra caber URL de verdade).
model KyriaCustomer {
  id             String      @id @db.VarChar(64)
  name           String      @db.VarChar(255)
  slug           String      @db.VarChar(100)
  status         KyriaStatus
  domainUrl      String?     @map("domain_url") @db.VarChar(500)
  createdAt      DateTime    @map("created_at")
  updatedAt      DateTime    @map("updated_at")
  // Campo interno (não vem da API) — documentado no mapeamento como referência a Cliente.codcli.
  // SEM FK Prisma de verdade, mesmo podendo (Cliente tem PK simples, diferente do caso
  // Consultor/codusu) — mesmo motivo: manter o model Cliente, que é do Senior, sem precisar
  // saber nada de Kyria. Nunca populado pelo sync automático — fica null até alguém vincular
  // manualmente pela tela "Ver dados".
  codcli         Int?
  sincronizadoEm DateTime    @updatedAt @map("sincronizado_em")

  // Lado inverso de KyriaTicket.customer — FK real (22/09/2026, pedido do Vitor: cruzar
  // kyria_tickets.customer_id com kyria_customers.id).
  tickets KyriaTicket[]
  // Lado inverso de KyriaCustomerHours.customer.
  horas KyriaCustomerHours[]

  @@map("kyria_customers")
}

// Domínio de `category` em GET /ticket-statuses, declarado no OpenAPI do Kyria (enum fechado de
// 6 valores) — mesmo espírito de KyriaStatus/KyriaMemberRole.
enum KyriaTicketStatusCategoria {
  triage
  queue
  awaiting_return
  execution
  done
  cancelled
}

// Espelho local do Kyria — GET /ticket-statuses (ver src/kyria/client.ts,
// src/kyria/ticketStatusesSync.ts). Campos/tipos do mapeamento registrado (recurso
// `/ticket-statuses`, Administração > Mapeamento de Campos). `status` reaproveita o enum
// `KyriaStatus` já existente (mesmo domínio active/inactive de Teams/Members/Customers) — não
// precisa de enum novo. `key` é o campo que `KyriaTicket.statusKey` referencia (22/09/2026,
// pedido do Vitor de cruzar as duas tabelas) — NÃO é o `id` opaco do Convex: conferido ao vivo
// contra os 12 status reais que `key` (ex. "aguardando-retorno") é único em todos, inclusive os
// 2 que têm `teamId` preenchido, então serve como alvo de FK mesmo sem ser a PK "oficial" do
// Kyria. `teamId` fica String solta, sem FK — só 2 dos 12 status têm time associado, e o pedido
// foi especificamente sobre `statusKey`, não sobre expandir esse vínculo também.
model KyriaTicketStatus {
  id             String                     @id @db.VarChar(64)
  teamId         String?                    @map("team_id") @db.VarChar(64)
  key            String                     @unique @db.VarChar(64)
  name           String                     @db.VarChar(255)
  color          String?                    @db.VarChar(16)
  category       KyriaTicketStatusCategoria
  status         KyriaStatus
  sortOrder      Int?                       @map("sort_order")
  sincronizadoEm DateTime                   @updatedAt @map("sincronizado_em")

  tickets KyriaTicket[]

  @@map("kyria_ticket_statuses")
}

// Domínio de `priority` em GET /tickets, declarado no OpenAPI do Kyria (enum fechado de 4
// valores) — mesmo espírito de KyriaStatus/KyriaMemberRole.
enum KyriaTicketPrioridade {
  low
  medium
  high
  urgent
}

// Espelho local do Kyria — GET /tickets (ver src/kyria/client.ts, src/kyria/ticketsSync.ts).
// Campos, tipos e TAMANHOS vieram do mapeamento registrado (recurso `/tickets`, Administração >
// Mapeamento de Campos) — o Vitor definiu os `@db.VarChar(n)` de propósito, e é a tabela que tem
// que bater com o que foi registrado lá, não o contrário. Duas correções em cima da amostra de 1
// registro que a tela usou pra sugerir tipo/tamanho (nenhum campo string do schema Ticket no
// OpenAPI declara `maxLength` — a ferramenta só podia mesmo chutar), MEDIDAS contra os 6.668
// tickets reais já sincronizados (22/09/2026), não a olho:
//   1. `closedAt`: a amostra tinha um ticket aberto (`closedAt: null`), tela sugeriu `String`;
//      conferido no OpenAPI que o campo real é `number|null` (epoch ms, igual `openedAt`/
//      `updatedAt`) — `DateTime?` aqui, e reescrito assim no mapeamento também.
//   2. `description`: `@db.VarChar(2000)` registrado estourava (máximo real 5.590 — um ticket
//      tinha um stack trace de erro inteiro colado). Decisão do Vitor: TEXT sem limite só pra
//      este campo, porque é nota de texto livre, não um identificador de formato previsível como
//      os outros — os demais campos ficam exatamente com o tamanho que ele definiu (`code`
//      VarChar(24), `title` VarChar(255), `teamId`/`responsibleUserId`/`requesterUserId`/
//      `customerId` VarChar(64) — todos couberam nos 6.668 reais, com folga).
//   3. `statusKey`: `@db.VarChar(15)` registrado estourava (máximo real 36 — vem de
//      /ticket-statuses, catálogo configurável por workspace, não um enum curto). Decisão do
//      Vitor: `VarChar(64)`, mesmo tamanho já usado pros IDs opacos do Convex.
//
// FKs reais (22/09/2026, pedido do Vitor) pra `team`/`responsavel`/`customer`/`status` —
// conferido ao vivo ANTES de adicionar que os 6.669 tickets locais não têm nenhuma referência
// órfã contra teams/members/customers já sincronizados. `requesterUserId` fica sem FK de
// propósito — não foi pedido, só `responsibleUserId`. O job (`ticketsSync.ts`) pré-filtra antes
// de gravar: `team`/`responsavel`/`customer` (nullable) viram `null` se a referência ainda não
// tiver sido sincronizada localmente; `status` (NOT NULL) faz o ticket inteiro ser pulado nesse
// caso — mesmo cuidado que uma FK de verdade em cima de upsert em lote exige (ver comentário
// grande no início do arquivo do job).
model KyriaTicket {
  id                String                @id @db.VarChar(64)
  code              String?               @db.VarChar(24)
  title             String                @db.VarChar(255)
  description       String?
  statusKey         String                @map("status_key") @db.VarChar(64)
  status            KyriaTicketStatus     @relation(fields: [statusKey], references: [key])
  priority          KyriaTicketPrioridade
  teamId            String?               @map("team_id") @db.VarChar(64)
  team              KyriaTeam?            @relation(fields: [teamId], references: [id])
  responsibleUserId String?               @map("responsible_user_id") @db.VarChar(64)
  responsavel       KyriaMember?          @relation(fields: [responsibleUserId], references: [id])
  requesterUserId   String                @map("requester_user_id") @db.VarChar(64)
  projectId         String?               @map("project_id")
  customerId        String?               @map("customer_id") @db.VarChar(64)
  customer          KyriaCustomer?        @relation(fields: [customerId], references: [id])
  openedAt          DateTime              @map("opened_at")
  updatedAt         DateTime              @map("updated_at")
  closedAt          DateTime?             @map("closed_at")
  parentTicketId    String?               @map("parent_ticket_id")
  revision          Int
  sincronizadoEm    DateTime              @updatedAt @map("sincronizado_em")

  horas KyriaTicketHours?

  @@map("kyria_tickets")
}

// Espelho local do Kyria — GET /reports/hours?groupBy=ticket (recurso `/reports/hours`, ver
// src/kyria/client.ts, src/kyria/ticketHoursSync.ts). 1 linha por ticket (`id` é FK de verdade
// pra KyriaTicket — as duas tabelas nasceram juntas nesta leva, decisão do Vitor de exigir
// integridade real, diferente de KyriaMember.codusu/KyriaCustomer.codcli, que documentam
// vínculo com tabelas de OUTRO sistema sem FK). `minutes` é o total da janela [janelaDe,
// janelaAte] mais recente, SUBSTITUÍDO inteiro a cada sync (não acumulado) — decisão do Vitor
// pra nunca desalinhar do Kyria se um apontamento antigo for editado/apagado lá. Janela fixa e
// curta (7 dias terminando ontem, ver ticketHoursSync.ts) porque testado ao vivo (22/09/2026):
// a API dá 503 "Time reporting data is not ready" pra quase todo o calendário fora de uma banda
// estreita recente — não dá pra confiar num range largo/histórico hoje.
model KyriaTicketHours {
  id             String      @id @db.VarChar(64)
  ticket         KyriaTicket @relation(fields: [id], references: [id])
  groupType      String      @map("group_type") @db.VarChar(25)
  code           String?     @db.VarChar(32)
  title          String      @db.VarChar(255)
  minutes        Decimal
  janelaDe       DateTime    @map("janela_de") @db.Date
  janelaAte      DateTime    @map("janela_ate") @db.Date
  sincronizadoEm DateTime    @updatedAt @map("sincronizado_em")

  @@map("kyria_ticket_hours")
}

// Espelho local do Kyria — GET /reports/hours?groupBy=customer (recurso #17, ver
// src/kyria/customerHoursSync.ts). Tempo de atendimento de cada cliente POR COMPETÊNCIA (mês):
// a chave é (competencia, customer_id). `competencia` é o dia 01 do mês consultado — derivado
// do intervalo pedido, não vem da API (kyria/competencia.ts); from/to sempre cobrem o mês
// inteiro. `minutes` é o total do mês, SUBSTITUÍDO a cada sync (não acumulado). Colunas e tipos
// seguem o mapeamento registrado (customer_id VARCHAR(64), igual a kyria_customers.id; FK real).
model KyriaCustomerHours {
  competencia    DateTime      @db.Date
  customerId     String        @map("customer_id") @db.VarChar(64)
  customer       KyriaCustomer @relation(fields: [customerId], references: [id])
  groupType      String?       @map("group_type") @db.VarChar(32)
  groupName      String?       @map("group_name") @db.VarChar(255)
  minutes        Decimal?      @db.Decimal(12, 2)
  sincronizadoEm DateTime      @updatedAt @map("sincronizado_em")

  @@id([competencia, customerId])
  @@map("kyria_customer_hours")
}

// Tipos selecionáveis ao registrar um campo (ver KyriaFieldMapping) — subconjunto fechado dos
// tipos escalares reais do Prisma (nunca string livre): garante que tudo que fica registrado é
// algo que um `model` do schema.prisma pode literalmente declarar. `Decimal` acrescentado a
// pedido do Vitor (18/09/2026) — usa `KyriaFieldMapping.precisao`/`escala` quando escolhido
// (mesmo par `@db.Decimal(precisao, escala)` que `soap/typeMapping.ts` já usa pro Senior).
enum KyriaTipoCampo {
  String
  Int
  BigInt
  Float
  Decimal
  Boolean
  DateTime
  Json
}

// Recurso Kyria registrado pro workflow de mapeamento de campos (Administração > Integração
// Kyria > Mapeamento de Campos, 18/09/2026, pedido do Vitor). Registrar aqui NÃO cria/altera
// tabela nenhuma — é uma especificação que o desenvolvedor usa depois pra escrever o model
// Prisma + migração de verdade, à mão, revisada (mesma disciplina de sempre, ver o comentário
// grande sobre `KyriaTeam.status` no histórico de migrations). `resourcePath` é a chave de
// negócio (ex.: "/teams") — sem relação obrigatória com `KyriaSyncJobDescriptor.jobName` (ver
// kyria/registry.ts), porque dá pra registrar um recurso bem antes dele virar um job de sync.
model KyriaResourceMapping {
  id            Int      @id @default(autoincrement())
  resourcePath  String   @unique @map("resource_path")
  displayName   String   @map("display_name")
  // JSON cru do registro de amostra usado na última pré-visualização — auditoria ("foi isso
  // que o admin viu ao decidir"), não consumido por nenhum código além da tela de detalhe.
  amostraBruta  Json?    @map("amostra_bruta")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  atualizadoPor Int?     @map("atualizado_por")

  campos KyriaFieldMapping[]

  @@map("kyria_resource_mappings")
}

// Um campo dentro de um recurso registrado. Re-registrar o recurso (POST .../register de novo)
// SUBSTITUI o conjunto inteiro de campos — sem edição parcial, é sempre "registrei de novo com
// o que vejo agora" (ver routes/syncKyriaMapping.ts).
model KyriaFieldMapping {
  id         Int                  @id @default(autoincrement())
  resourceId Int                  @map("resource_id")
  resource   KyriaResourceMapping @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  // Nome do campo como veio na resposta real do Kyria — para campo achatado de um objeto
  // aninhado (ex.: "group.id" dentro de "group"), usa notação de ponto (22/09/2026, pedido do
  // Vitor em cima do mapeamento de /reports/hours: um objeto raso vira campos próprios, não um
  // Json opaco só). Só o que continuar aninhado 2+ níveis, ou array, ainda entra como UMA linha
  // Json inteira (ex.: `KyriaTeam.appearance`). NULL = campo INTERNO — não existe na API, só do
  // nosso lado (ex.: FK pra outra tabela do CaxHub), registrado pela tela sem passar por
  // preview nenhum (18/09/2026, pedido do Vitor).
  // Exceção: em relatórios de horas com groupBy no path, `competencia` é DERIVADO do mês consultado
  // (kyria/competencia.ts), não vem da resposta da API — o preview o injeta como primeiro campo.
  nomeOrigem    String?        @map("nome_origem")
  ordem         Int
  manter        Boolean        @default(true)
  tipoEscolhido KyriaTipoCampo @map("tipo_escolhido")
  // Sempre snake_case minúsculo, normalizado a partir do nome de origem (camelCase) tanto no
  // frontend quanto no backend (ver paraSnakeCase em routes/syncKyriaMapping.ts) — vira o nome
  // da coluna Postgres de verdade na migração, mesma convenção já usada em toda tabela
  // CaxHub-nativa deste schema (`parent_team_id`, `sincronizado_em`, ...).
  nomeInterno   String         @map("nome_interno")
  nullable      Boolean        @default(true)
  // Tamanho de `String` (`@db.VarChar(tamanho)`) — null = TEXT sem limite. Só faz sentido
  // quando tipoEscolhido = String; ignorado (mas não apagado) se o admin trocar de tipo depois.
  tamanho       Int?
  // Precisão/escala de `Decimal` (`@db.Decimal(precisao, escala)`, mesmo par que
  // soap/typeMapping.ts já usa pro Senior) — só fazem sentido quando tipoEscolhido = Decimal.
  precisao      Int?
  escala        Int?

  // Documentação de relacionamento (opcional, vale pra QUALQUER campo — interno ou vindo da
  // API, ex.: um "customerId" já mapeado também pode apontar pro Cliente.id local) — "este
  // campo é pensado como FK pra Modelo.campo" no schema real que eu escrevo depois. NÃO gera
  // FK/constraint nenhuma aqui, é só texto. `relacionamentoModelo` é o nome do MODEL Prisma
  // (ex.: "Proposta"), não da tabela (@@map) — é o que entra num `@relation` de verdade. Os
  // dois são opcionais EM CONJUNTO: um sem o outro é especificação incompleta, validado no
  // backend (ver GET /internal-models e POST /register em routes/syncKyriaMapping.ts).
  relacionamentoModelo         String? @map("relacionamento_modelo")
  relacionamentoCampo          String? @map("relacionamento_campo")
  // Campo ESCALAR do mesmo relacionamentoModelo a mostrar como rótulo legível na tela "Ver
  // dados" (ex.: Consultor.nomfor) — opcional, só faz sentido quando relacionamentoModelo/Campo
  // já estão preenchidos (não validado como "os três juntos ou nenhum": um relacionamento sem
  // descrição é válido, só não ganha rótulo). 18/09/2026, pedido do Vitor.
  relacionamentoCampoDescricao String? @map("relacionamento_campo_descricao")

  // Referência, só leitura — o que a amostra e o OpenAPI sugeriam, pro admin decidir em cima.
  // Tudo NULL num campo interno (não há amostra da API pra inferir nada).
  tipoInferidoAmostra String?  @map("tipo_inferido_amostra")
  valorExemplo        String?  @map("valor_exemplo")
  tipoOpenApi         String?  @map("tipo_openapi")
  nullableOpenApi     Boolean? @map("nullable_openapi")
  enumOpenApi         Json?    @map("enum_openapi")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([resourceId])
  @@map("kyria_field_mappings")
}

// Espelho local da tabela E075PRO do Senior ERP (Cadastros - Produtos).
model Produto {
  codemp           Int
  codpro           String    @db.VarChar(14)
