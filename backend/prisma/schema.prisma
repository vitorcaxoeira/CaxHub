  // nasça no CaxHub em vez de vir do Senior.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  // Quando a varredura constatou que a linha sumiu da origem. NULL = viva. Volta a NULL
  // sozinho se a linha reaparecer, porque todo upsert grava NULL aqui. Nunca há DELETE.
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  // FK formalizada depois de checar órfãos com dado real (0 órfãos em 146 linhas, 24/08/2026).
  notaFiscalVenda NotaFiscalVenda @relation(fields: [codemp, codfil, codsnf, numnfv], references: [codemp, codfil, codsnf, numnfv])

  @@id([codemp, codfil, codsnf, numnfv, seqipv])
  @@map("itens_produto_nfv")
}

// Espelho local da tabela E140RAT do Senior ERP (Vendas - Notas Fiscais de Saída - Rateios).
model RateioNfVenda {
  codemp           Int
  codfil           Int
  codsnf           String    @db.VarChar(3)
  numnfv           Int
  seqrat           Int
  // Campos abaixo acrescentados a pedido do Vitor (24/08/2026, mesma sessão) — ordem seguindo
