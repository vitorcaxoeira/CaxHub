// ─────────────────────────────────────────────────────────────────────────────
// Módulo Gestão de Solicitações — Solicitações de Viagem (hospedagem, passagem aérea e
// aluguel de carro). Dado 100% do CaxHub, sem integração com o Senior. Sem FK para Proposta
// (PK composta): guarda codemp+codpro soltos, como as demais solicitações.
// ─────────────────────────────────────────────────────────────────────────────

model SolicitacaoViagem {
  id                       Int       @id @default(autoincrement())
  solicitanteId            Int?
  /// projeto | comercial | interna | treinamento | outro — define se cliente/proposta são obrigatórios.
  finalidade               String    @db.VarChar(20)
  motivo                   String    @db.VarChar(1000)
  codcli                   Int?
  codemp                   Int?
  codpro                   Int?
  qtdPessoas               Int       @default(1)
  dataInicio               DateTime  @db.Date
  dataFim                  DateTime  @db.Date
  cidadesDestino           String    @db.VarChar(500)
  roteiroObservacao        String?   @db.Text
  observacoes              String?   @db.Text
  precisaHospedagem        Boolean   @default(false)
  precisaAereo             Boolean   @default(false)
  precisaCarro             Boolean   @default(false)
  /// solicitada | em_cotacao | aguardando_aprovacao | aprovada | reprovada | reservada | finalizada | cancelada
  status                   String    @default("solicitada") @db.VarChar(30)
  responsavelAtendimentoId Int?
  // Snapshot do departamento cujo gestor aprova (Consultor.codemp/depexe do solicitante na criação).
  aprovacaoCodemp          Int?
  aprovacaoDepexe          Int?
  valorAprovado            Decimal?  @db.Decimal(12, 2)
  aprovadoPorId            Int?
  aprovadoEm               DateTime?
  observacaoDecisao        String?   @db.VarChar(1000)
  motivoCancelamento       String?   @db.VarChar(1000)
  criadoEm                 DateTime  @default(now())
  atualizadoEm             DateTime  @updatedAt

  solicitante User?    @relation("viagemSolicitante", fields: [solicitanteId], references: [id], onDelete: SetNull)
  atendimento User?    @relation("viagemAtendimento", fields: [responsavelAtendimentoId], references: [id], onDelete: SetNull)
  aprovador   User?    @relation("viagemAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  cliente     Cliente? @relation(fields: [codcli], references: [codcli], onDelete: SetNull)

  viajantes    SolicitacaoViagemViajante[]
  itens        SolicitacaoViagemItem[]
  cotacoes     SolicitacaoViagemCotacao[]
  anexos       SolicitacaoViagemAnexo[]
  notificacoes Notificacao[]

  @@index([status])
  @@index([solicitanteId])
  @@index([codemp, codpro])
  @@index([codcli])
  @@map("solicitacoes_viagem")
}

model SolicitacaoViagemViajante {
  id            Int    @id @default(autoincrement())
  solicitacaoId Int
  userId        Int?
  nome          String @db.VarChar(150)
  /// Só dígitos (11), ou vazio quando não informado (opcional). Nunca vai para auditoria/diff.
  cpf           String @db.VarChar(11)

  solicitacao SolicitacaoViagem               @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  user        User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  itens       SolicitacaoViagemItemViajante[]

  @@index([solicitacaoId])
  @@map("solicitacoes_viagem_viajantes")
}

model SolicitacaoViagemItem {
  id            Int    @id @default(autoincrement())
  solicitacaoId Int
  /// hospedagem | aereo | carro
  tipo          String @db.VarChar(15)
  ordem         Int    @default(0)

  // Campos por tipo (todos anuláveis): dataInicio/dataFim = check-in/out, ida/volta, retirada/devolução.
  cidade               String?   @db.VarChar(150)
  origem               String?   @db.VarChar(150)
  destino              String?   @db.VarChar(150)
  dataInicio           DateTime? @db.Date
  dataFim              DateTime? @db.Date
  horaInicio           String?   @db.VarChar(5)
  horaFim              String?   @db.VarChar(5)
  tipoAcomodacao       String?   @db.VarChar(15)
  hotelPreferencia     String?   @db.VarChar(200)
  necessidades         String?   @db.VarChar(500)
  flexibilidadeHorario String?   @db.VarChar(200)
  bagagem              String?   @db.VarChar(200)
  companhiaPreferencia String?   @db.VarChar(100)
  localRetirada        String?   @db.VarChar(200)
  localDevolucao       String?   @db.VarChar(200)
  categoriaVeiculo     String?   @db.VarChar(100)
  observacoes          String?   @db.VarChar(1000)

  // Reserva (preenchida pelo atendimento).
  fornecedor     String?   @db.VarChar(150)
  localizador    String?   @db.VarChar(100)
  valorReservado Decimal?  @db.Decimal(12, 2)
  reservadoEm    DateTime?

  solicitacao SolicitacaoViagem               @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  viajantes   SolicitacaoViagemItemViajante[]
  cotacoes    SolicitacaoViagemCotacao[]
  anexos      SolicitacaoViagemAnexo[]

  @@index([solicitacaoId])
  @@map("solicitacoes_viagem_itens")
}

model SolicitacaoViagemItemViajante {
  itemId     Int
  viajanteId Int

  item     SolicitacaoViagemItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  viajante SolicitacaoViagemViajante @relation(fields: [viajanteId], references: [id], onDelete: Cascade)

  @@id([itemId, viajanteId])
  @@map("solicitacoes_viagem_itens_viajantes")
}

model SolicitacaoViagemCotacao {
  id            Int       @id @default(autoincrement())
  solicitacaoId Int
  itemId        Int?
  fornecedor    String    @db.VarChar(150)
  descricao     String?   @db.VarChar(500)
  valor         Decimal   @db.Decimal(12, 2)
  validadeAte   DateTime? @db.Date
  selecionada   Boolean   @default(false)
  criadoPorId   Int?
  criadoEm      DateTime  @default(now())

  solicitacao SolicitacaoViagem        @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  item        SolicitacaoViagemItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  criadoPor   User?                    @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  anexos      SolicitacaoViagemAnexo[]

  @@index([solicitacaoId])
  @@map("solicitacoes_viagem_cotacoes")
}

model SolicitacaoViagemAnexo {
  id             Int      @id @default(autoincrement())
  solicitacaoId  Int
  itemId         Int?
  cotacaoId      Int?
  userId         Int?
  /// cotacao | comprovante | voucher | outro
  categoria      String   @default("outro") @db.VarChar(15)
  nomeArquivo    String   @db.VarChar(255)
  caminhoArquivo String   @db.VarChar(500)
  tamanhoBytes   Int
  mimeType       String   @db.VarChar(100)
  criadoEm       DateTime @default(now())

  solicitacao SolicitacaoViagem         @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  item        SolicitacaoViagemItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  cotacao     SolicitacaoViagemCotacao? @relation(fields: [cotacaoId], references: [id], onDelete: SetNull)
  user        User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([solicitacaoId])
  @@map("solicitacoes_viagem_anexos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Módulo Gestão 5S — auditorias mensais de setores e ambientes comuns. Dado 100% do CaxHub.
// Acesso por cadastro próprio (Participante5S), independente do papel do usuário.
// ─────────────────────────────────────────────────────────────────────────────

model Area5S {
  id               Int      @id @default(autoincrement())
  nome             String   @db.VarChar(120)
  /// setor | comum
  tipo             String   @db.VarChar(10)
  /// Ambiente comum pode ficar vinculado a um setor (o líder desse setor passa a ver o ambiente).
  setorVinculadoId Int?
  ativo            Boolean  @default(true)
  ordem            Int      @default(0)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  setorVinculado Area5S?              @relation("areaVinculo", fields: [setorVinculadoId], references: [id], onDelete: SetNull)
  ambientes      Area5S[]             @relation("areaVinculo")
  perguntas      Pergunta5S[]
  avaliacoes     Avaliacao5S[]
  lideres        Participante5SArea[]
  observacoes    Observacao5S[]

  @@index([tipo])
  @@map("areas_5s")
}

model Pergunta5S {
  id           Int      @id @default(autoincrement())
  /// setor | comum — a que tipo de área a pergunta se aplica.
  tipoArea     String   @db.VarChar(10)
  /// Null = vale para todas as áreas do tipo; preenchido = só para aquela área.
  areaId       Int?
  /// seiri | seiton | seiso | seiketsu | shitsuke
  senso        String   @db.VarChar(12)
  texto        String   @db.VarChar(600)
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  area      Area5S?               @relation(fields: [areaId], references: [id], onDelete: Cascade)
  respostas Avaliacao5SResposta[]

  @@index([tipoArea, senso])
  @@index([areaId])
  @@map("perguntas_5s")
}

model Participante5S {
  id       Int      @id @default(autoincrement())
  userId   Int      @unique
  /// coordenador | avaliador | lider
  papel    String   @db.VarChar(15)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  areas Participante5SArea[]

  @@map("participantes_5s")
}

model Participante5SArea {
  participanteId Int
  areaId         Int

  participante Participante5S @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  area         Area5S         @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([participanteId, areaId])
  @@map("participantes_5s_areas")
}

model Avaliacao5S {
  id           Int       @id @default(autoincrement())
  titulo       String    @db.VarChar(200)
  areaId       Int
  avaliadorId  Int?
  data         DateTime  @db.Date
  /// em_andamento | finalizada
  status       String    @default("em_andamento") @db.VarChar(15)
  // Cache dos percentuais (0–100, null = sem resposta aplicável), recalculado a cada gravação.
  percGeral    Decimal?  @db.Decimal(5, 2)
  percSeiri    Decimal?  @db.Decimal(5, 2)
  percSeiton   Decimal?  @db.Decimal(5, 2)
  percSeiso    Decimal?  @db.Decimal(5, 2)
  percSeiketsu Decimal?  @db.Decimal(5, 2)
  percShitsuke Decimal?  @db.Decimal(5, 2)
  finalizadaEm DateTime?
  /// Preenchido nas avaliações de ambiente abertas pela área agrupadora (o pai é só um invólucro, sem respostas).
  avaliacaoPaiId Int?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  area        Area5S                @relation(fields: [areaId], references: [id])
  avaliador   User?                 @relation(fields: [avaliadorId], references: [id], onDelete: SetNull)
  respostas   Avaliacao5SResposta[]
  sensos      Avaliacao5SSenso[]
  observacoes Observacao5S[]
  pai       Avaliacao5S?  @relation("avaliacaoFilhas", fields: [avaliacaoPaiId], references: [id], onDelete: Cascade)
  filhas    Avaliacao5S[] @relation("avaliacaoFilhas")

  @@index([areaId, data])
  @@index([status])
  @@index([avaliacaoPaiId])
  @@map("avaliacoes_5s")
}

model Avaliacao5SResposta {
  id             Int     @id @default(autoincrement())
  avaliacaoId    Int
  perguntaId     Int?
  // Snapshot da pergunta: editar o formulário depois não altera o histórico.
  senso          String  @db.VarChar(12)
  perguntaTexto  String  @db.VarChar(600)
  ordem          Int     @default(0)
  /// 1–5, ou null quando ainda sem resposta / não se aplica.
  nota           Int?
  naoSeAplica    Boolean @default(false)
  inconsistencia String? @db.Text
  complemento    String? @db.Text

  avaliacao Avaliacao5S @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  pergunta  Pergunta5S? @relation(fields: [perguntaId], references: [id], onDelete: SetNull)
  imagens   Imagem5S[]

  @@unique([avaliacaoId, perguntaId])
  @@index([avaliacaoId])
  @@map("avaliacoes_5s_respostas")
}

model Avaliacao5SSenso {
  id            Int     @id @default(autoincrement())
  avaliacaoId   Int
  senso         String  @db.VarChar(12)
  observacoes   String? @db.Text
  melhorias     String? @db.Text
  pontosAtencao String? @db.Text
  informacoes   String? @db.Text

  avaliacao Avaliacao5S @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  imagens   Imagem5S[]

  @@unique([avaliacaoId, senso])
  @@map("avaliacoes_5s_sensos")
}

model Observacao5S {
  id           Int      @id @default(autoincrement())
  areaId       Int
  autorId      Int?
  dataOcorrido DateTime @db.Date
  texto        String   @db.Text
  avaliacaoId  Int?
  criadoEm     DateTime @default(now())

  area      Area5S       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  autor     User?        @relation(fields: [autorId], references: [id], onDelete: SetNull)
  avaliacao Avaliacao5S? @relation(fields: [avaliacaoId], references: [id], onDelete: SetNull)
  imagens   Imagem5S[]

  @@index([areaId, dataOcorrido])
  @@map("observacoes_equipe_5s")
}

model Imagem5S {
  id               Int      @id @default(autoincrement())
  respostaId       Int?
  avaliacaoSensoId Int?
  observacaoId     Int?
  userId           Int?
  nomeArquivo      String   @db.VarChar(255)
  caminhoArquivo   String   @db.VarChar(500)
  tamanhoBytes     Int
  mimeType         String   @db.VarChar(100)
  criadoEm         DateTime @default(now())

  resposta       Avaliacao5SResposta? @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  avaliacaoSenso Avaliacao5SSenso?    @relation(fields: [avaliacaoSensoId], references: [id], onDelete: Cascade)
  observacao     Observacao5S?        @relation(fields: [observacaoId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([respostaId])
  @@index([avaliacaoSensoId])
  @@index([observacaoId])
  @@map("imagens_5s")
}

// Espelho local da tabela E095FOR do Senior ERP (Cadastros - Fornecedores).
//
// Recorte de 16 dos 150 campos da tabela real — identidade, endereço e situação, no
// mesmo espírito de Cliente/Representante. Fora ficam ~130 campos fiscais de baixíssimo
// uso (regime tributário, PIS/Cofins, DIRF, CBS/IBS, WMS, ANP...) e os 2 campos USU_
// (USU_ReeDesp, USU_GrpFor), que não entram por definição de recorte do projeto — só
// tabela padrão. Sem FK: nenhum outro model referencia CodFor hoje.
model Fornecedor {
  codfor           Int       @id
  nomfor           String    @db.VarChar(100)
  apefor           String    @db.VarChar(50)
  /// Domínio "LJurFis": J=Pessoa Jurídica, F=Pessoa Física
  tipfor           String    @db.VarChar(1)
  /// Domínio "LTipMe2": I=Interno (Nacional), E=Externo (Exterior), P=Prospect.
  tipmer           String    @db.VarChar(1)
  codram           String?   @db.VarChar(5)
  insest           String?   @db.VarChar(25)
  cgccpf           BigInt?
  endfor           String?   @db.VarChar(100)
  cplend           String?   @db.VarChar(200)
  cepfor           Int?
  baifor           String?   @db.VarChar(75)
  cidfor           String?   @db.VarChar(60)
  sigufs           String?   @db.VarChar(2)
  codpai           String?   @db.VarChar(4)
  /// Domínio "LSitReg": A=Ativo, I=Inativo
  sitfor           String    @db.VarChar(1)
  // Colunas de controle de exclusão — só schema por enquanto, ver comentário em Empresa.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  titulosPagar        TituloPagar[]

  @@map("fornecedores")
}

// Espelho local da tabela E501TCP do Senior ERP (C. Pagar - Títulos - Dados Gerais).
// Espelho de TituloReceber, do outro lado do fluxo — acrescentada em 16/09/2026 pro DRE
// (o Atlas não tinha nenhuma tabela de Contas a Pagar até aqui). Recorte enxuto (a tabela
// real tem ~180 colunas, quase todas cálculo de retenção/imposto) — identidade, datas,
// valor, situação, e o eixo ctafin/ctared/codccu/codtns pedido explicitamente.
model TituloPagar {
  codemp           Int
  codfil           Int
  numtit           String    @db.VarChar(15)
  codtpt           String    @db.VarChar(3)
  codfor           Int
  codtns           String    @db.VarChar(5)
  /// Domínio "LSitTit": mesmo domínio de TituloReceber.sittit
  sittit           String    @db.VarChar(2)
  datemi           DateTime  @db.Date
  datent           DateTime  @db.Date
  vctori           DateTime  @db.Date
  vctpro           DateTime  @db.Date
  vlrori           Decimal   @db.Decimal(15, 2)
  vlrabe           Decimal?  @db.Decimal(15, 2)
  codfpg           Int?
  codpor           String    @db.VarChar(4)
  codmoe           String?   @db.VarChar(3)
  ctafin           Int?
  ctared           Int?
  codccu           String?   @db.VarChar(9)
  numprj           Int?
  codfpj           Int?
  obstcp           String?   @db.VarChar(250)
  // Colunas de controle de exclusão — só schema por enquanto, ver comentário em Empresa.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  fornecedor Fornecedor             @relation(fields: [codfor], references: [codfor])
  movimentos MovimentoTituloPagar[]
  rateios    RateioTituloPagar[]

  @@id([codemp, codfil, numtit, codtpt, codfor])
  @@index([codfor, sittit])
  @@map("titulos_pagar")
}

// Espelho local da tabela E501MCP do Senior ERP (C. Pagar - Títulos - Movimentos).
model MovimentoTituloPagar {
  codemp           Int
  codfil           Int
  numtit           String    @db.VarChar(15)
  codtpt           String    @db.VarChar(3)
  codfor           Int
  seqmov           Int
  codtns           String    @db.VarChar(5)
  datmov           DateTime  @db.Date
  datpgt           DateTime? @db.Date
  vlrmov           Decimal   @db.Decimal(15, 2)
  vlrliq           Decimal?  @db.Decimal(15, 2)
  diaatr           Int?
  codpor           String?   @db.VarChar(4)
  codcrt           String?   @db.VarChar(2)
  ctafin           Int?
  ctared           Int?
  codccu           String?   @db.VarChar(9)
  // Vínculo com o movimento de tesouraria que esta baixa gerou (E600MCC) — confirmado no
  // dicionário em 16/09/2026, do lado oposto ao par filmcr/nummcr/tptmcr/seqmcr que
  // MovimentoConta já tem pro C. Receber (E600MCC não tem o equivalente pro Pagar).
  numcco           String?   @db.VarChar(14)
  datcco           DateTime? @db.Date
  seqcco           Int?
  // Movimento do C. Receber relacionado (encontro de contas) — casamento por valor.
  seqmcr           Int?
  /// Domínio "LSimNao": S=Sim, N=Não — indicativo se o movimento foi lançado no plano financeiro
  lctfin           String    @db.VarChar(1)
  // Colunas de controle de exclusão — só schema por enquanto, ver comentário em Empresa.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  tituloPagar TituloPagar @relation(fields: [codemp, codfil, numtit, codtpt, codfor], references: [codemp, codfil, numtit, codtpt, codfor])
  transacao   Transacao   @relation(fields: [codemp, codtns], references: [codemp, codtns])

  @@id([codemp, codfil, numtit, codtpt, codfor, seqmov])
  @@map("movimentos_pagar")
}

// Espelho local da tabela E501RAT do Senior ERP (C. Pagar - Títulos - Rateios dos
// Movimentos) — linha de FATO da DRE do lado Pagar, espelho de RateioTituloReceber.
model RateioTituloPagar {
  codemp           Int
  codfil           Int
  numtit           String    @db.VarChar(15)
  codtpt           String    @db.VarChar(3)
  codfor           Int
  seqmov           Int
  seqrat           Int
  datbas           DateTime? @db.Date
  codtns           String?   @db.VarChar(5)
  mesano           DateTime? @db.Date
  /// Domínio "LCriRat": mesmo domínio de RateioTituloReceber.crirat
  crirat           Int
  /// Domínio "LSomSub": mesmo domínio de RateioTituloReceber.somsub
  somsub           Int
  numprj           Int?
  codfpj           Int?
  ctafin           Int?
  ctared           Int?
  percta           Decimal?  @db.Decimal(11, 4)
  vlrcta           Decimal?  @db.Decimal(15, 2)
  codccu           String?   @db.VarChar(9)
  perrat           Decimal?  @db.Decimal(11, 4)
  vlrrat           Decimal?  @db.Decimal(15, 2)
  obsrat           String?   @db.VarChar(120)
  // Colunas de controle de exclusão — só schema por enquanto, ver comentário em Empresa.
  vistoEmSync      DateTime? @map("visto_em_sync") @db.Timestamptz(6)
  removidoEmSenior DateTime? @map("removido_em_senior") @db.Timestamptz(6)

  tituloPagar TituloPagar @relation(fields: [codemp, codfil, numtit, codtpt, codfor], references: [codemp, codfil, numtit, codtpt, codfor])

  @@id([codemp, codfil, numtit, codtpt, codfor, seqmov, seqrat])
  @@index([codemp, ctafin, datbas])
  @@map("rateios_pagar")
}

// Liga/desliga por job Kyria (Administração > Integração Kyria). Sem linha = ativo (default).
// Inativo bloqueia a execução manual e a agendada — ver src/kyria/jobAtivo.ts.
model KyriaSyncConfig {
  jobName      String   @id @map("job_name") @db.VarChar(64)
  ativo        Boolean  @default(true)
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("kyria_sync_config")
}
